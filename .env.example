# URL publik aplikasi (dipakai untuk validasi origin / CSRF)
APP_BASE_URL=http://localhost:3000

# Akun admin tunggal. Gunakan kata sandi yang kuat.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Kunci tanda tangan cookie sesi, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mengganti nilai ini (atau ADMIN_PASSWORD) otomatis mengeluarkan semua sesi login.
SESSION_SECRET=

# Google Sheets - ID spreadsheet database (bagian URL di antara /d/ dan /edit)
GOOGLE_SPREADSHEET_ID=

# Google Service Account
# Lokal: path ke file kredensial JSON (JANGAN di-commit, simpan di luar folder proyek)
GOOGLE_APPLICATION_CREDENTIALS=
# Hosting tanpa file (mis. Vercel): isi JSON mentah atau base64. Diutamakan bila diisi.
# GOOGLE_SERVICE_ACCOUNT_JSON=
